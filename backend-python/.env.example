# SmartSchedule Backend Environment Variables
# COPY this file to .env and fill in your actual values
# NEVER commit .env to version control!

# JWT Configuration
JWT_SECRET=GANTI_DENGAN_SECRET_RANDOM_MINIMAL_32_KARAKTER
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:///smartschedule.db

# Supabase Cloud
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://backend-python-lime.vercel.app,http://localhost:3000
